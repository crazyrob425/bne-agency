      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Outfit:wght@300;400;600&family=JetBrains+Mono&display=swap');\n\n  .font-display { font-family: 'Cormorant Garamond', serif; }\n  .font-sans { font-family: 'Outfit', sans-serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  .luxury-gradient-bg {\n    background: radial-gradient(circle at 50% -20%, oklch(0.25 0.08 85 / 0.15) 0%, oklch(0.04 0.005 85) 70%);\n  }\n  \n  .gold-glow {\n    filter: drop-shadow(0 0 15px oklch(0.78 0.16 85 / 0.4));\n  }\n\n  .glass-card {\n    background: oklch(0.1 0.01 85 / 0.4);\n    backdrop-filter: blur(12px);\n    border: 1px solid oklch(0.78 0.16 85 / 0.15);\n  }\n\n  .gold-border-hover:hover {\n    border-color: oklch(0.78 0.16 85 / 0.5);\n    box-shadow: 0 0 30px oklch(0.78 0.16 85 / 0.1);\n  }\n\n  .gradient-text-gold {\n    background: linear-gradient(135deg, oklch(0.85 0.12 90), oklch(0.78 0.16 85), oklch(0.72 0.14 75));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-10px); }\n  }\n  .animate-float { animation: float 6s ease-in-out infinite; }\n</style>\n\n<div class=\"bg-[#0a0a0a] text-[oklch(0.94_0.01_85)] font-sans selection:bg-[oklch(0.78_0.16_85/0.2)] selection:text-[oklch(0.78_0.16_85)]\" data-kid=\"1\">\n  \n  \n  <section class=\"relative min-h-screen flex items-center justify-center overflow-hidden luxury-gradient-bg\" data-kid=\"2\">\n    \n    <div class=\"absolute inset-0 z-0\" data-kid=\"3\">\n      <img src=\"https://images.unsplash.com/photo-1596257828689-c822bad48989?auto=format&w=1440&q=80&fit=crop\" alt=\"Gold Dust Particles by Allec Gomes\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-20 mix-blend-screen\" data-kid=\"4\">\n    </div>\n    \n    \n    <div class=\"container relative z-10 text-center\" data-kid=\"5\">\n      <div class=\"inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[oklch(0.78_0.16_85/0.3)] bg-[oklch(0.78_0.16_85/0.05)] mb-12 animate-float\" data-kid=\"6\">\n        <span class=\"w-2 h-2 rounded-full bg-[oklch(0.78_0.16_85)] animate-pulse\" data-kid=\"7\"></span>\n        <span class=\"text-[oklch(0.78_0.16_85)] text-xs font-semibold tracking-[0.2em] uppercase\" data-kid=\"8\">The Silent Architect</span>\n      </div>\n      \n      <h1 class=\"font-display text-7xl md:text-9xl font-bold leading-[0.9] tracking-tighter mb-8 max-w-5xl mx-auto\" data-kid=\"9\">\n        GO MAKE YOUR <span class=\"gradient-text-gold\" data-kid=\"10\">MONEY.</span>\n      </h1>\n      \n      <p class=\"text-[oklch(0.65_0.012_85)] text-xl md:text-2xl max-w-2xl mx-auto mb-16 font-light leading-relaxed\" data-kid=\"11\">\n        We handle the grind & the danger. You focus on the talent. \n        A silent partner for elite creators scaling to the top 1%.\n      </p>\n      \n      <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\" data-kid=\"12\">\n        <button class=\"px-10 py-5 bg-[oklch(0.78_0.16_85)] text-[#0a0a0a] rounded-full font-bold text-lg hover:scale-105 transition-transform gold-glow active:scale-95\" data-kid=\"13\">\n          Build Your Empire Plan\n        </button>\n        <button class=\"px-10 py-5 border border-[oklch(0.78_0.16_85/0.3)] rounded-full font-bold text-lg hover:bg-[oklch(0.78_0.16_85/0.05)] transition-all active:scale-95\" data-kid=\"14\">\n          Explore Silence\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#0a0a0a] to-transparent\" data-kid=\"15\"></div>\n  </section>\n\n  \n  <section class=\"py-32 relative\" data-kid=\"16\">\n    <div class=\"container\" data-kid=\"17\">\n      <div class=\"grid lg:grid-cols-2 gap-24 items-center\" data-kid=\"18\">\n        <div class=\"relative\" data-kid=\"19\">\n          <div class=\"absolute -top-20 -left-20 w-64 h-64 bg-[oklch(0.78_0.16_85/0.1)] blur-[80px] rounded-full\" data-kid=\"20\"></div>\n          <h2 class=\"font-display text-5xl md:text-6xl font-bold mb-10 leading-tight\" data-kid=\"21\">\n            The Invisible Hand<br data-kid=\"22\">Behind The Curtain.\n          </h2>\n          <div class=\"space-y-8\" data-kid=\"23\">\n            <div class=\"flex gap-6\" data-kid=\"24\">\n              <div class=\"w-12 h-12 shrink-0 rounded-xl bg-[oklch(0.78_0.16_85/0.1)] border border-[oklch(0.78_0.16_85/0.2)] flex items-center justify-center\" data-kid=\"25\">\n                <i class=\"lucide-zap text-[oklch(0.78_0.16_85)]\" data-kid=\"26\"></i>\n              </div>\n              <div data-kid=\"27\">\n                <h4 class=\"text-xl font-bold mb-2\" data-kid=\"28\">Backend Automation</h4>\n                <p class=\"text-[oklch(0.58_0.015_85)] leading-relaxed\" data-kid=\"29\">Scheduling, posting, and classification managed by our operators 24/7. Your digital presence never sleeps.</p>\n              </div>\n            </div>\n            <div class=\"flex gap-6\" data-kid=\"30\">\n              <div class=\"w-12 h-12 shrink-0 rounded-xl bg-[oklch(0.78_0.16_85/0.1)] border border-[oklch(0.78_0.16_85/0.2)] flex items-center justify-center\" data-kid=\"31\">\n                <i class=\"lucide-shield text-[oklch(0.78_0.16_85)]\" data-kid=\"32\"></i>\n              </div>\n              <div data-kid=\"33\">\n                <h4 class=\"text-xl font-bold mb-2\" data-kid=\"34\">Ironclad Vetting</h4>\n                <p class=\"text-[oklch(0.58_0.015_85)] leading-relaxed\" data-kid=\"35\">Advanced screening protocols for in-person dates. We verify identity and safety before you even see a booking.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"relative lg:pl-12\" data-kid=\"36\">\n          <div class=\"glass-card p-10 rounded-3xl relative z-10 border-[oklch(0.78_0.16_85/0.2)]\" data-kid=\"37\">\n            <div class=\"font-mono text-[oklch(0.78_0.16_85)] text-sm mb-6 tracking-widest\" data-kid=\"38\">SYSTEM_STATUS: OPERATIONAL</div>\n            <div class=\"space-y-6\" data-kid=\"39\">\n              <div class=\"h-2 bg-white/5 rounded-full overflow-hidden\" data-kid=\"40\">\n                <div class=\"h-full w-[88%] bg-[oklch(0.78_0.16_85)] rounded-full\" data-kid=\"41\"></div>\n              </div>\n              <div class=\"flex justify-between text-sm font-bold\" data-kid=\"42\">\n                <span data-kid=\"43\">REVENUE OPTIMIZATION</span>\n                <span class=\"text-[oklch(0.78_0.16_85)]\" data-kid=\"44\">+340%</span>\n              </div>\n              <div class=\"h-2 bg-white/5 rounded-full overflow-hidden\" data-kid=\"45\">\n                <div class=\"h-full w-[100%] bg-[oklch(0.78_0.16_85)] rounded-full\" data-kid=\"46\"></div>\n              </div>\n              <div class=\"flex justify-between text-sm font-bold\" data-kid=\"47\">\n                <span data-kid=\"48\">PRIVACY SHIELD</span>\n                <span class=\"text-[oklch(0.78_0.16_85)]\" data-kid=\"49\">MAXIMUM</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"absolute -bottom-10 -right-10 w-80 h-80 bg-[oklch(0.78_0.16_85/0.05)] blur-[100px] rounded-full\" data-kid=\"50\"></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-[oklch(0.06_0.006_85)]\" data-kid=\"51\">\n    <div class=\"container\" data-kid=\"52\">\n      <div class=\"text-center mb-24\" data-kid=\"53\">\n        <h2 class=\"font-display text-6xl font-bold mb-6\" data-kid=\"54\">Scale To The Top 1%.</h2>\n        <p class=\"text-[oklch(0.58_0.015_85)] text-lg max-w-xl mx-auto italic font-display\" data-kid=\"55\">\n          \"Generic content doesn't pay the bills. Niche domination does.\"\n        </p>\n      </div>\n      \n      <div class=\"grid md:grid-cols-3 gap-8\" data-kid=\"56\">\n        <div class=\"glass-card p-8 rounded-2xl gold-border-hover group transition-all\" data-kid=\"57\">\n          <div class=\"text-4xl font-display font-bold text-[oklch(0.78_0.16_85)] mb-4\" data-kid=\"58\">01.</div>\n          <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"59\">The Talent</h3>\n          <p class=\"text-[oklch(0.58_0.015_85)] mb-8\" data-kid=\"60\">You create. You engage. You embody the brand. Your energy is the product.</p>\n          <div class=\"pt-6 border-t border-white/5 text-sm font-mono text-white/30 tracking-widest uppercase\" data-kid=\"61\">Input Stage</div>\n        </div>\n        \n        <div class=\"glass-card p-8 rounded-2xl gold-border-hover group transition-all border-[oklch(0.78_0.16_85/0.4)] bg-[oklch(0.78_0.16_85/0.03)] scale-105\" data-kid=\"62\">\n          <div class=\"text-4xl font-display font-bold text-[oklch(0.78_0.16_85)] mb-4\" data-kid=\"63\">02.</div>\n          <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"64\">The Architect</h3>\n          <p class=\"text-[oklch(0.58_0.015_85)] mb-8\" data-kid=\"65\">BNE manages the setup, compliance, scheduling, and screening. We are the silent operator.</p>\n          <div class=\"pt-6 border-t border-white/5 text-sm font-mono text-[oklch(0.78_0.16_85)] tracking-widest uppercase\" data-kid=\"66\">Active Bridge</div>\n        </div>\n        \n        <div class=\"glass-card p-8 rounded-2xl gold-border-hover group transition-all\" data-kid=\"67\">\n          <div class=\"text-4xl font-display font-bold text-[oklch(0.78_0.16_85)] mb-4\" data-kid=\"68\">03.</div>\n          <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"69\">The Empire</h3>\n          <p class=\"text-[oklch(0.58_0.015_85)] mb-8\" data-kid=\"70\">Multi-platform revenue. Maximum safety. Generational cash flow unlocked.</p>\n          <div class=\"pt-6 border-t border-white/5 text-sm font-mono text-white/30 tracking-widest uppercase\" data-kid=\"71\">Output Stage</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 relative overflow-hidden\" data-kid=\"72\">\n    <div class=\"absolute inset-0 z-0\" data-kid=\"73\">\n      <img src=\"https://images.unsplash.com/photo-1627704442358-61c8e05c7bf4?auto=format&w=1440&q=80&fit=crop\" alt=\"Luxury Gold Silk Background by Zac Ong\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-10\" data-kid=\"74\">\n    </div>\n    \n    <div class=\"container relative z-10\" data-kid=\"75\">\n      <div class=\"max-w-3xl mx-auto text-center mb-20\" data-kid=\"76\">\n        <div class=\"w-16 h-16 rounded-2xl bg-[oklch(0.78_0.16_85/0.1)] border border-[oklch(0.78_0.16_85/0.3)] flex items-center justify-center mx-auto mb-8 gold-glow\" data-kid=\"77\">\n          <i class=\"lucide-lock text-[oklch(0.78_0.16_85)] text-3xl\" data-kid=\"78\"></i>\n        </div>\n        <h2 class=\"font-display text-6xl font-bold mb-8\" data-kid=\"79\">The Security Vault</h2>\n        <p class=\"text-[oklch(0.65_0.012_85)] text-lg leading-relaxed\" data-kid=\"80\">\n          In this industry, privacy isn’t a luxury—it’s your primary defense. We build a literal firewall between your real life and your cash flow.\n        </p>\n      </div>\n      \n      <div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\" data-kid=\"81\">\n        <div class=\"glass-card p-6 rounded-2xl border-white/5\" data-kid=\"82\">\n          <h4 class=\"font-bold mb-3 text-lg\" data-kid=\"83\">Region Blocking</h4>\n          <p class=\"text-sm text-[oklch(0.58_0.015_85)]\" data-kid=\"84\">Total geographical isolation from family, coworkers, and exes.</p>\n        </div>\n        <div class=\"glass-card p-6 rounded-2xl border-white/5\" data-kid=\"85\">\n          <h4 class=\"font-bold mb-3 text-lg\" data-kid=\"86\">Banking Privacy</h4>\n          <p class=\"text-sm text-[oklch(0.58_0.015_85)]\" data-kid=\"87\">Secure payment routing and isolated financial pathways.</p>\n        </div>\n        <div class=\"glass-card p-6 rounded-2xl border-white/5\" data-kid=\"88\">\n          <h4 class=\"font-bold mb-3 text-lg\" data-kid=\"89\">Leaked Content Sweep</h4>\n          <p class=\"text-sm text-[oklch(0.58_0.015_85)]\" data-kid=\"90\">24/7 automated sweeps and aggressive DMCA takedowns.</p>\n        </div>\n        <div class=\"glass-card p-6 rounded-2xl border-white/5\" data-kid=\"91\">\n          <h4 class=\"font-bold mb-3 text-lg\" data-kid=\"92\">§ 2257 Compliance</h4>\n          <p class=\"text-sm text-[oklch(0.58_0.015_85)]\" data-kid=\"93\">Full legal red-tape management and record-keeping.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 bg-[#050505] relative border-t border-[oklch(0.78_0.16_85/0.1)]\" data-kid=\"94\">\n    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[oklch(0.78_0.16_85/0.03)] blur-[150px] rounded-full\" data-kid=\"95\"></div>\n    <div class=\"container relative z-10 text-center\" data-kid=\"96\">\n      <h2 class=\"font-display text-7xl font-bold mb-10 leading-none\" data-kid=\"97\">\n        Ready To <span class=\"gradient-text-gold\" data-kid=\"98\">Take Over?</span>\n      </h2>\n      <p class=\"text-[oklch(0.65_0.012_85)] text-xl mb-16 max-w-xl mx-auto leading-relaxed\" data-kid=\"99\">\n        Whether you are starting from zero or ready to pivot your brand, we meet you where you are.\n      </p>\n      <button class=\"px-16 py-6 bg-[oklch(0.78_0.16_85)] text-[#0a0a0a] rounded-full font-bold text-xl hover:scale-105 transition-transform gold-glow active:scale-95 shadow-2xl\" data-kid=\"100\">\n        Build Your Empire Plan\n      </button>\n      <div class=\"mt-8 text-[oklch(0.45_0.01_85)] text-sm tracking-widest font-mono\" data-kid=\"101\">STRICT NDA PROTECTION FROM MINUTE ONE</div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 border-t border-white/5 text-center\" data-kid=\"102\">\n    <div class=\"container\" data-kid=\"103\">\n      <div class=\"font-display text-2xl font-bold mb-4 gradient-text-gold\" data-kid=\"104\">BNE AGENCY</div>\n      <p class=\"text-[oklch(0.45_0.01_85)] text-sm mb-8\" data-kid=\"105\">© 2026 Blacklisted Niche Entertainment. Silent Partners to the Elite.</p>\n      <div class=\"flex justify-center gap-8 text-[oklch(0.45_0.01_85)] text-xs uppercase tracking-widest\" data-kid=\"106\">\n        <a href=\"#\" class=\"hover:text-[oklch(0.78_0.16_85)] transition-colors\" data-kid=\"107\">Privacy Policy</a>\n        <a href=\"#\" class=\"hover:text-[oklch(0.78_0.16_85)] transition-colors\" data-kid=\"108\">Terms of Silence</a>\n        <a href=\"#\" class=\"hover:text-[oklch(0.78_0.16_85)] transition-colors\" data-kid=\"109\">Compliance</a>\n      </div>\n    </div>\n  </footer>\n\n</div>\n\n\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"110\"></script>\n<script data-kid=\"111\">\n  lucide.createIcons();\n</script>",
