      "html": "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Outfit:wght@300;400;600&family=JetBrains+Mono&display=swap');\n\n  :root {\n    --background: oklch(0.04 0.005 85);\n    --foreground: oklch(0.94 0.01 85);\n    --primary: oklch(0.78 0.16 85);\n    --border-gold: oklch(0.78 0.16 85 / 20%);\n    --muted: oklch(0.58 0.015 85);\n  }\n\n  body {\n    background-color: var(--background);\n    color: var(--foreground);\n    font-family: 'Outfit', sans-serif;\n    margin: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-display { font-family: 'Cormorant Garamond', serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  .grid-line { border-color: var(--border-gold); }\n  \n  .vertical-text {\n    writing-mode: vertical-rl;\n    text-orientation: mixed;\n  }\n\n  .btn-luxury {\n    border: 1px solid var(--border-gold);\n    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n  .btn-luxury:hover {\n    background-color: var(--primary);\n    color: var(--background);\n    border-color: var(--primary);\n  }\n</style>\n\n<div class=\"min-h-screen border-x grid-line max-w-[1440px] mx-auto relative overflow-hidden\" data-kid=\"2\">\n  \n  \n  <section class=\"h-screen flex border-b grid-line relative\" data-kid=\"3\">\n    \n    <div class=\"w-24 border-r grid-line flex flex-col items-center py-12 justify-between shrink-0\" data-kid=\"4\">\n      <div class=\"flex flex-col items-center gap-4\" data-kid=\"5\">\n        <div class=\"w-10 h-10 border grid-line flex items-center justify-center rounded-sm\" data-kid=\"6\">\n           <i class=\"ti ti-crown text-[var(--primary)] text-xl\" data-kid=\"7\"></i>\n        </div>\n        <span class=\"vertical-text font-mono text-[10px] tracking-[0.4em] text-[var(--muted)] uppercase\" data-kid=\"8\">Est. 2024</span>\n      </div>\n      <div class=\"vertical-text font-display text-lg tracking-widest text-[var(--primary)] font-semibold\" data-kid=\"9\">BLACK&GOLD</div>\n    </div>\n\n    \n    <div class=\"flex-1 flex flex-col\" data-kid=\"10\">\n      \n      <nav class=\"h-24 border-b grid-line flex items-center justify-between px-12\" data-kid=\"11\">\n        <div class=\"font-display text-3xl font-bold tracking-tighter\" data-kid=\"12\">BNE<span class=\"text-[var(--primary)]\" data-kid=\"13\">.</span></div>\n        <div class=\"hidden md:flex gap-12 font-mono text-[10px] tracking-[0.3em] uppercase\" data-kid=\"14\">\n          <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"15\">Strategy</a>\n          <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"16\">Operations</a>\n          <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"17\">Security</a>\n          <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors text-[var(--primary)] underline underline-offset-8\" data-kid=\"18\">Apply</a>\n        </div>\n      </nav>\n\n      \n      <div class=\"flex-1 grid lg:grid-cols-2\" data-kid=\"19\">\n        <div class=\"p-12 md:p-24 flex flex-col justify-center border-r grid-line\" data-kid=\"20\">\n          <div class=\"inline-flex items-center gap-3 mb-8\" data-kid=\"21\">\n            <div class=\"w-8 h-px bg-[var(--primary)]\" data-kid=\"22\"></div>\n            <span class=\"font-mono text-[10px] tracking-[0.3em] uppercase text-[var(--primary)]\" data-kid=\"23\">Private Operations Partner</span>\n          </div>\n          <h1 class=\"font-display text-7xl md:text-9xl font-semibold leading-[0.9] mb-12\" data-kid=\"24\">\n            Talent to <br data-kid=\"25\"> <span class=\"italic text-[var(--primary)]\" data-kid=\"26\">Empire.</span>\n          </h1>\n          <p class=\"text-xl md:text-2xl font-light leading-relaxed text-[var(--muted)] max-w-lg mb-12\" data-kid=\"27\">\n            We handle the grind and the danger. You focus on the art of making money. Silent, secure, and aggressive growth for elite creators.\n          </p>\n          <div class=\"flex gap-6\" data-kid=\"28\">\n            <button class=\"btn-luxury px-10 py-5 rounded-sm font-mono text-xs tracking-widest uppercase\" data-kid=\"29\">\n              Begin Onboarding\n            </button>\n          </div>\n        </div>\n        <div class=\"relative bg-[radial-gradient(circle_at_center,var(--border-gold),transparent)] flex items-center justify-center p-12 overflow-hidden\" data-kid=\"30\">\n           <div class=\"absolute inset-0 opacity-10 flex items-center justify-center select-none pointer-events-none\" data-kid=\"31\">\n             <span class=\"font-display text-[25rem] font-bold leading-none translate-y-12\" data-kid=\"32\">BNE</span>\n           </div>\n           <div class=\"relative z-10 text-center max-w-sm\" data-kid=\"33\">\n             <div class=\"text-6xl font-display italic mb-4\" data-kid=\"34\">\"Silent power is the ultimate leverage.\"</div>\n             <div class=\"h-px w-24 bg-[var(--primary)] mx-auto mb-4\" data-kid=\"35\"></div>\n             <div class=\"font-mono text-[10px] tracking-widest uppercase\" data-kid=\"36\">Operations Manual v2.0</div>\n           </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"border-b grid-line\" data-kid=\"37\">\n    <div class=\"grid lg:grid-cols-4 min-h-[500px]\" data-kid=\"38\">\n      <div class=\"border-r grid-line p-12 flex flex-col justify-between\" data-kid=\"39\">\n        <h2 class=\"font-display text-4xl italic\" data-kid=\"40\">Empires <br data-kid=\"41\"> Under <br data-kid=\"42\"> Management</h2>\n        <div class=\"font-mono text-[10px] tracking-widest uppercase text-[var(--muted)]\" data-kid=\"43\">01 // Case Studies</div>\n      </div>\n      <div class=\"border-r grid-line p-12 group hover:bg-[var(--primary)]/5 transition-colors\" data-kid=\"44\">\n        <div class=\"flex justify-between items-start mb-12\" data-kid=\"45\">\n          <span class=\"font-mono text-xs text-[var(--primary)]\" data-kid=\"46\">01</span>\n          <i class=\"ti ti-zap text-xl\" data-kid=\"47\"></i>\n        </div>\n        <h3 class=\"font-display text-2xl mb-4\" data-kid=\"48\">The Digital Hegemony</h3>\n        <p class=\"text-sm text-[var(--muted)] font-light leading-relaxed mb-8\" data-kid=\"49\">Webcam & OnlyFans orchestration across 12 platforms. 340% revenue lift in 90 days.</p>\n        <a href=\"#\" class=\"font-mono text-[10px] tracking-widest uppercase flex items-center gap-2 group-hover:text-[var(--primary)]\" data-kid=\"50\">View Stats <i class=\"ti ti-arrow-right\" data-kid=\"51\"></i></a>\n      </div>\n      <div class=\"border-r grid-line p-12 group hover:bg-[var(--primary)]/5 transition-colors\" data-kid=\"52\">\n        <div class=\"flex justify-between items-start mb-12\" data-kid=\"53\">\n          <span class=\"font-mono text-xs text-[var(--primary)]\" data-kid=\"54\">02</span>\n          <i class=\"ti ti-shield text-xl\" data-kid=\"55\"></i>\n        </div>\n        <h3 class=\"font-display text-2xl mb-4\" data-kid=\"56\">The Physical Vanguard</h3>\n        <p class=\"text-sm text-[var(--muted)] font-light leading-relaxed mb-8\" data-kid=\"57\">High-end in-person companion safety & logistics. Zero incidents, 100% vetted pipelines.</p>\n        <a href=\"#\" class=\"font-mono text-[10px] tracking-widest uppercase flex items-center gap-2 group-hover:text-[var(--primary)]\" data-kid=\"58\">View Security <i class=\"ti ti-arrow-right\" data-kid=\"59\"></i></a>\n      </div>\n      <div class=\"p-12 group hover:bg-[var(--primary)]/5 transition-colors\" data-kid=\"60\">\n        <div class=\"flex justify-between items-start mb-12\" data-kid=\"61\">\n          <span class=\"font-mono text-xs text-[var(--primary)]\" data-kid=\"62\">03</span>\n          <i class=\"ti ti-crown text-xl\" data-kid=\"63\"></i>\n        </div>\n        <h3 class=\"font-display text-2xl mb-4\" data-kid=\"64\">The Niche Monopoly</h3>\n        <p class=\"text-sm text-[var(--muted)] font-light leading-relaxed mb-8\" data-kid=\"65\">Dominating deep fetish markets through surgical specificity and content strategy.</p>\n        <a href=\"#\" class=\"font-mono text-[10px] tracking-widest uppercase flex items-center gap-2 group-hover:text-[var(--primary)]\" data-kid=\"66\">View Niche <i class=\"ti ti-arrow-right\" data-kid=\"67\"></i></a>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-12 md:px-24 border-b grid-line\" data-kid=\"68\">\n    <div class=\"max-w-4xl\" data-kid=\"69\">\n      <span class=\"font-mono text-[10px] tracking-[0.4em] uppercase text-[var(--primary)] mb-6 block\" data-kid=\"70\">The BNE Firewall</span>\n      <h2 class=\"font-display text-6xl md:text-8xl mb-24 leading-tight\" data-kid=\"71\">Security is not a <br data-kid=\"72\"> luxury. It is a <br data-kid=\"73\"> <span class=\"italic\" data-kid=\"74\">requirement.</span></h2>\n      \n      <div class=\"grid md:grid-cols-2 gap-24\" data-kid=\"75\">\n        <div class=\"flex gap-8\" data-kid=\"76\">\n          <i class=\"ti ti-eye text-4xl text-[var(--primary)]\" data-kid=\"77\"></i>\n          <div data-kid=\"78\">\n            <h4 class=\"font-display text-3xl mb-4\" data-kid=\"79\">Geographical Firewalls</h4>\n            <p class=\"text-[var(--muted)] font-light leading-relaxed\" data-kid=\"80\">Block entire regions, cities, or associations. Your digital footprint is invisible to anyone outside your target audience.</p>\n          </div>\n        </div>\n        <div class=\"flex gap-8\" data-kid=\"81\">\n          <i class=\"ti ti-lock text-4xl text-[var(--primary)]\" data-kid=\"82\"></i>\n          <div data-kid=\"83\">\n            <h4 class=\"font-display text-3xl mb-4\" data-kid=\"84\">Identity Decoupling</h4>\n            <p class=\"text-[var(--muted)] font-light leading-relaxed\" data-kid=\"85\">Total separation of legal and brand identity. Secure banking, private LLCs, and anonymous operational pipelines.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"p-12 md:p-24 grid md:grid-cols-2 gap-12\" data-kid=\"86\">\n    <div data-kid=\"87\">\n      <div class=\"font-display text-4xl font-bold mb-8 italic\" data-kid=\"88\">BNE.</div>\n      <div class=\"font-mono text-[10px] tracking-widest text-[var(--muted)] uppercase\" data-kid=\"89\">© 2024 Blacklisted Niche Entertainment. All Rights Reserved.</div>\n    </div>\n    <div class=\"flex flex-col md:items-end gap-6 font-mono text-xs tracking-widest uppercase\" data-kid=\"90\">\n      <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"91\">Privacy Protocol</a>\n      <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"92\">Legal Vault</a>\n      <a href=\"#\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"93\">Contact Terminal</a>\n    </div>\n  </footer>\n\n</div>",
