      "html": "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;600&family=JetBrains+Mono:wght@400;500&display=swap');\n\n  :root {\n    --background: #0a0a0a;\n    --gold: oklch(0.78 0.16 85);\n    --gold-muted: oklch(0.78 0.16 85 / 0.2);\n    --gold-glow: oklch(0.78 0.16 85 / 0.1);\n    --text-primary: oklch(0.94 0.01 85);\n    --text-muted: oklch(0.58 0.015 85);\n  }\n\n  body {\n    background-color: var(--background);\n    color: var(--text-primary);\n    font-family: 'Outfit', sans-serif;\n    margin: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-display { font-family: 'Cormorant Garamond', serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  .luxury-glass {\n    background: linear-gradient(145deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(212, 175, 55, 0.15);\n    border-radius: 24px;\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);\n  }\n\n  .gold-glow {\n    box-shadow: 0 0 20px var(--gold-glow);\n  }\n\n  .btn-gold {\n    background: linear-gradient(135deg, oklch(0.82 0.14 90) 0%, oklch(0.76 0.16 85) 50%, oklch(0.70 0.12 80) 100%);\n    color: #0a0a0a;\n    font-weight: 600;\n    padding: 12px 24px;\n    border-radius: 9999px;\n    transition: all 0.3s ease;\n    border: none;\n    cursor: pointer;\n  }\n\n  .btn-gold:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 0 30px oklch(0.78 0.16 85 / 0.4);\n  }\n\n  .status-badge {\n    padding: 4px 12px;\n    border-radius: 9999px;\n    font-size: 11px;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  .status-accepted { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }\n  .status-vetting { background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); }\n  .status-paid { background: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.2); }\n\n  .referral-input {\n    background: rgba(255, 255, 255, 0.02);\n    border: 1px solid var(--gold-muted);\n    color: var(--gold);\n    padding: 16px;\n    border-radius: 12px;\n    font-family: 'JetBrains Mono', monospace;\n    width: 100%;\n    outline: none;\n  }\n</style>\n\n<div class=\"min-h-screen p-8 md:p-12 relative overflow-hidden\" data-kid=\"2\">\n  \n  <div class=\"absolute top-0 right-0 w-[600px] h-[600px] bg-[oklch(0.78_0.16_85/0.05)] blur-[120px] rounded-full pointer-events-none\" data-kid=\"3\"></div>\n  <div class=\"absolute bottom-0 left-0 w-[400px] h-[400px] bg-[oklch(0.78_0.16_85/0.03)] blur-[100px] rounded-full pointer-events-none\" data-kid=\"4\"></div>\n\n  <div class=\"max-w-6xl mx-auto relative z-10\" data-kid=\"5\">\n    \n    <header class=\"flex justify-between items-center mb-16\" data-kid=\"6\">\n      <div data-kid=\"7\">\n        <h1 class=\"font-display text-4xl md:text-5xl font-bold mb-2\" data-kid=\"8\">Referral <span class=\"text-[var(--gold)]\" data-kid=\"9\">Portal</span></h1>\n        <p class=\"text-[var(--text-muted)] font-light tracking-wide uppercase text-xs\" data-kid=\"10\">Blacklisted Niche Entertainment // Silent Partner Program</p>\n      </div>\n      <div class=\"text-right\" data-kid=\"11\">\n        <div class=\"text-[var(--text-muted)] text-xs mb-1 uppercase tracking-widest\" data-kid=\"12\">Logged in as</div>\n        <div class=\"font-semibold text-[var(--gold)]\" data-kid=\"13\">elite_partner_42</div>\n      </div>\n    </header>\n\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8\" data-kid=\"14\">\n      \n      <div class=\"lg:col-span-2 grid grid-cols-1 md:grid-cols-3 gap-4\" data-kid=\"15\">\n        <div class=\"luxury-glass p-6 border-l-4 border-l-[var(--gold)]\" data-kid=\"16\">\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"17\">\n            <i class=\"ti ti-currency-dollar text-2xl text-[var(--gold)]\" data-kid=\"18\"></i>\n            <span class=\"text-xs uppercase tracking-widest text-[var(--text-muted)]\" data-kid=\"19\">Total Earned</span>\n          </div>\n          <div class=\"text-4xl font-bold font-display\" data-kid=\"20\">$12,450.00</div>\n          <div class=\"text-[10px] text-emerald-500 mt-2 flex items-center gap-1\" data-kid=\"21\">\n            <i class=\"ti ti-chart-line\" data-kid=\"22\"></i> +$850 this week\n          </div>\n        </div>\n\n        <div class=\"luxury-glass p-6\" data-kid=\"23\">\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"24\">\n            <i class=\"ti ti-users-plus text-2xl text-[var(--gold)]\" data-kid=\"25\"></i>\n            <span class=\"text-xs uppercase tracking-widest text-[var(--text-muted)]\" data-kid=\"26\">Applicants</span>\n          </div>\n          <div class=\"text-4xl font-bold font-display\" data-kid=\"27\">42</div>\n          <div class=\"text-[10px] text-[var(--text-muted)] mt-2\" data-kid=\"28\">12 Active Vetting</div>\n        </div>\n\n        <div class=\"luxury-glass p-6\" data-kid=\"29\">\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"30\">\n            <i class=\"ti ti-chart-arcs text-2xl text-[var(--gold)]\" data-kid=\"31\"></i>\n            <span class=\"text-xs uppercase tracking-widest text-[var(--text-muted)]\" data-kid=\"32\">Conversion</span>\n          </div>\n          <div class=\"text-4xl font-bold font-display\" data-kid=\"33\">28.5%</div>\n          <div class=\"text-[10px] text-[var(--text-muted)] mt-2\" data-kid=\"34\">Above network average</div>\n        </div>\n      </div>\n\n      \n      <div class=\"luxury-glass p-8 flex flex-col justify-between relative overflow-hidden group\" data-kid=\"35\">\n        <div class=\"absolute top-0 right-0 w-24 h-24 bg-[var(--gold)] opacity-[0.05] blur-2xl group-hover:opacity-[0.1] transition-opacity\" data-kid=\"36\"></div>\n        <div data-kid=\"37\">\n          <h3 class=\"font-display text-xl mb-4\" data-kid=\"38\">Your Empire Link</h3>\n          <div class=\"relative mb-6\" data-kid=\"39\">\n            <input type=\"text\" readonly value=\"bne.studio/ref/42-elite\" class=\"referral-input gold-glow\" data-kid=\"40\">\n            <button class=\"absolute right-4 top-1/2 -translate-y-1/2 text-[var(--gold)] hover:text-white transition-colors\" data-kid=\"41\">\n              <i class=\"ti ti-copy\" data-kid=\"42\"></i>\n            </button>\n          </div>\n        </div>\n        <button class=\"btn-gold w-full flex items-center justify-center gap-2\" data-kid=\"43\">\n          <i class=\"ti ti-share\" data-kid=\"44\"></i> Share Pipeline\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-4 gap-8\" data-kid=\"45\">\n      \n      <div class=\"lg:col-span-1 space-y-6\" data-kid=\"46\">\n        <div class=\"luxury-glass p-6\" data-kid=\"47\">\n          <h3 class=\"font-display text-xl mb-6\" data-kid=\"48\">Income Share Monitor</h3>\n          <div class=\"space-y-4\" data-kid=\"49\">\n            <div class=\"flex justify-between items-end border-b border-white/5 pb-2\" data-kid=\"50\">\n              <span class=\"text-xs text-[var(--text-muted)] uppercase\" data-kid=\"51\">Base Payment</span>\n              <span class=\"font-mono text-[var(--gold)]\" data-kid=\"52\">$25.00</span>\n            </div>\n            <div class=\"flex justify-between items-end border-b border-white/5 pb-2\" data-kid=\"53\">\n              <span class=\"text-xs text-[var(--text-muted)] uppercase\" data-kid=\"54\">Residual Rate</span>\n              <span class=\"font-mono text-[var(--gold)]\" data-kid=\"55\">5.0%</span>\n            </div>\n            <div class=\"pt-4\" data-kid=\"56\">\n              <p class=\"text-[10px] text-[var(--text-muted)] italic leading-relaxed\" data-kid=\"57\">\n                *Residual rates are adjustable based on applicant niche and total network volume.\n              </p>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"luxury-glass p-6 bg-gradient-to-br from-[oklch(0.78_0.16_85/0.05)] to-transparent\" data-kid=\"58\">\n          <h4 class=\"text-xs font-bold text-[var(--gold)] uppercase tracking-widest mb-2\" data-kid=\"59\">Next Payout</h4>\n          <div class=\"text-2xl font-display mb-1\" data-kid=\"60\">July 15, 2026</div>\n          <div class=\"text-sm text-[var(--text-muted)]\" data-kid=\"61\">Estimated: $2,450.00</div>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-3\" data-kid=\"62\">\n        <div class=\"luxury-glass overflow-hidden\" data-kid=\"63\">\n          <div class=\"p-6 border-b border-white/5 flex justify-between items-center\" data-kid=\"64\">\n            <h3 class=\"font-display text-xl\" data-kid=\"65\">Applicant Pipeline</h3>\n            <div class=\"flex gap-2\" data-kid=\"66\">\n              <button class=\"text-xs text-[var(--text-muted)] hover:text-[var(--gold)]\" data-kid=\"67\">Export CSV</button>\n            </div>\n          </div>\n          <div class=\"overflow-x-auto\" data-kid=\"68\">\n            <table class=\"w-full text-left border-collapse\" data-kid=\"69\">\n              <thead data-kid=\"70\">\n                <tr class=\"text-[10px] text-[var(--text-muted)] uppercase tracking-widest\" data-kid=\"71\">\n                  <th class=\"p-6 border-b border-white/5\" data-kid=\"72\">Applicant ID</th>\n                  <th class=\"p-6 border-b border-white/5\" data-kid=\"73\">Date Applied</th>\n                  <th class=\"p-6 border-b border-white/5\" data-kid=\"74\">Niche</th>\n                  <th class=\"p-6 border-b border-white/5\" data-kid=\"75\">Status</th>\n                  <th class=\"p-6 border-b border-white/5 text-right\" data-kid=\"76\">Potentia