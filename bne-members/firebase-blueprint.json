{
  "entities": {
    "User": {
      "title": "User",
      "description": "A member or admin of the BNE portal",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "role": {
          "type": "string",
          "enum": ["member", "admin"],
          "description": "Role of the user, member or admin"
        },
        "expirationDate": {
           "type": "string",
           "format": "date-time",
           "description": "Date when the account automatically suspends/expires"
        },
        "status": {
           "type": "string",
           "enum": ["active", "suspended", "archived"],
           "description": "Current status"
        },
        "persona": {
            "type": "string",
            "description": "Public persona name"
        },
        "contactInfo": {
            "type": "string",
            "description": "Contact methods"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        },
         "updatedAt": {
            "type": "string",
            "format": "date-time"
        }
      },
      "required": ["email", "role", "status", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A secure message sent between users",
      "type": "object",
        "properties": {
          "senderId": {
             "type": "string"
          },
          "receiverId": {
             "type": "string"
          },
          "content": {
             "type": "string"
          },
          "attachments": {
              "type": "array",
              "items": { "type": "string" },
               "description": "List of URLs of the attached files"
          },
           "createdAt": {
            "type": "string",
            "format": "date-time"
          }
      },
        "required": ["senderId", "receiverId", "content", "createdAt"]
    },
    "FileRecord": {
      "title": "FileRecord",
      "description": "Metadata for a file uploaded to the file storage portal",
      "type": "object",
       "properties": {
           "ownerId": {
             "type": "string"
           },
           "fileName": {
              "type": "string"
           },
           "fileUrl": {
             "type": "string"
           },
           "mimeType": {
             "type": "string"
           },
           "sizeBytes": {
             "type": "integer"
           },
           "createdAt": {
            "type": "string",
            "format": "date-time"
          }
       },
       "required": ["ownerId", "fileName", "fileUrl", "createdAt"]
    },
    "AdTemplate": {
       "title": "AdTemplate",
       "description": "A saved classified ad generated by the user",
       "type": "object",
       "properties": {
          "ownerId": { "type": "string" },
          "title": { "type": "string" },
          "htmlContent": { "type": "string" },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
       },
       "required": ["ownerId", "title", "htmlContent", "createdAt"]
    },
    "ClassifiedAd": {
        "title": "ClassifiedAd",
        "description": "A post looking for co-stars, locations, etc.",
        "type": "object",
        "properties": {
             "ownerId": { "type": "string" },
             "ownerPersona": { "type": "string" },
             "title": { "type": "string" },
             "description": { "type": "string" },
             "category": { "type": "string", "enum": ["co-star", "location", "prop", "security", "driver", "other"] },
             "location": {"type": "string", "description": "GPS/Zip code general area"},
              "createdAt": {
                "type": "string",
                "format": "date-time"
             }
        },
        "required": ["ownerId", "title", "description", "category", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users and their statuses"
    },
    "messages/{messageId}": {
        "schema": { "$ref": "#/entities/Message" },
        "description": "Secure cross communication."
    },
    "files/{fileId}": {
       "schema": { "$ref": "#/entities/FileRecord" },
       "description": "File references in storage"
    },
    "adTemplates/{templateId}": {
       "schema": { "$ref": "#/entities/AdTemplate" },
       "description": "Saved classified ad templates"
    },
    "classifieds/{adId}": {
         "schema": { "$ref": "#/entities/ClassifiedAd" },
         "description": "Internal classified ads for co-stars etc"
    }
  }
}
