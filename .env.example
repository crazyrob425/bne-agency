# ─── Niche Matcher: Progress Saving & Re-Engagement ───────────────────────────
# Local-account auth
JWT_SECRET=change-me-to-a-long-random-string

# Database (Drizzle / MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/bne_agency

# Site URLs used in email links + unsubscribe
VITE_SITE_URL=https://blacklisted.studio
SITE_URL=https://blacklisted.studio

# Email delivery (optional). If unset, emails are logged to console (dev mode).
# SMTP is used by server/_core/mailer.ts. Swap for Resend/SES by editing that file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Blacklisted Studio <no-reply@blacklisted.studio>
