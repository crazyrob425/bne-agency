# STRIPE_SECRET_KEY=your_stripe_secret_key_here
# STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here  
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# OAuth Portal (if using external OAuth service)
# VITE_APP_ID=your_app_id
# VITE_OAUTH_PORTAL_URL=https://your-oauth-provider.com

# Production site URL (overrides window.location.origin for OAuth redirects)
# VITE_SITE_URL=https://blacklisted.studio

# Cloudflare API Token (recommended for automation)
# CLOUDFLARE_TOKEN=cfk_...

# Cloudflare R2 account and bucket
# R2_ACCOUNT_ID=your_32_hex_account_id
# R2_BUCKET_NAME=your_bucket_name

# Remote media base URL (e.g. R2 public bucket URL)
# VITE_MEDIA_BASE_URL=https://pub-xxxx.r2.dev

# Owner OpenID (auto-assigns admin role on first login)
# OWNER_OPEN_ID=your_openid_here

# Analytics (optional)
# VITE_ANALYTICS_ENDPOINT=your_analytics_endpoint
# VITE_ANALYTICS_WEBSITE_ID=your_website_id

# API URL (for separate backend deployment on Render)
# VITE_API_URL=https://your-render-service.onrender.com/api/trpc
