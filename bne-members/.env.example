# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OAuth Portal Configuration (for integrated authentication with main BNE server)
# VITE_OAUTH_PORTAL_URL: URL of the main OAuth server (leave empty to use Firebase popup)
# When running as part of the main bne-agency server, this should be the same origin.
# Example: VITE_OAUTH_PORTAL_URL=https://your-domain.com
VITE_OAUTH_PORTAL_URL=

# VITE_APP_ID: Application ID for OAuth authentication
VITE_APP_ID=
